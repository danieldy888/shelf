{
  "name": "Shelf",
  "identifier": "local.y3.shelf",
  "version": "1.8.0",
  "updates": {
    "publicKey": "U392UXk3CKWS5zmlwlygGPnVbOppcJHEMJEeKXXBbAo=",
    "github": "henryyu333/shelf"
  },
  "out": "dist.noindex",
  "buildCommand": "go generate ./...",
  "macos": {
    "minimumSystemVersion": "13.0",
    "signingIdentity": "-",
    "infoPlist": {
      "LSUIElement": true,
      "NSHighResolutionCapable": true,
      "NSServices": [
        {
          "NSMenuItem": { "default": "添加到 Shelf" },
          "NSMessage": "addToShelf",
          "NSPortName": "Shelf",
          "NSRequiredContext": {},
          "NSSendTypes": ["NSStringPboardType", "public.utf8-plain-text"],
          "NSSendFileTypes": ["public.file-url", "public.item"]
        }
      ]
    }
  }
}

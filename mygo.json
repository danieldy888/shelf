{
  "name": "Shelf",
  "identifier": "local.y3.shelf",
  "version": "1.0.8",
  "out": "dist.noindex",
  "macos": {
    "minimumSystemVersion": "13.0",
    "signingIdentity": "-",
    "infoPlist": {
      "LSUIElement": true,
      "NSHighResolutionCapable": true,
      "NSServices": [
        {
          "NSMenuItem": { "default": "添加到 Shelf" },
          "NSMessage": "addToShelf",
          "NSPortName": "Shelf",
          "NSRequiredContext": {},
          "NSSendTypes": ["NSStringPboardType", "public.utf8-plain-text"],
          "NSSendFileTypes": ["public.file-url", "public.item"]
        }
      ]
    }
  }
}
